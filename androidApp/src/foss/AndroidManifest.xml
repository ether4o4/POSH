<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SMS read/send are opt-in, FOSS-only features. These permissions are intentionally
      declared only in the `foss` product flavor so the Play Store variant never
      requests them (Play policy restricts READ_SMS and SEND_SMS to default SMS
      handlers). The SMS feature gates itself at runtime on READ_SMS being declared
      in the merged manifest, so the Play variant never shows the feature at all.
      Read and send are independent user opt-ins at runtime.
    -->
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>

    <!--
      Device control needs to enumerate and launch installed apps (device_open_app).
      QUERY_ALL_PACKAGES is Play-restricted, so it lives in the FOSS flavor only; the
      device_open_app tool simply finds no launchable apps without it.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>

    <!--
      Notification reading is FOSS-only for the same reason as SMS: Play Store policy
      restricts BIND_NOTIFICATION_LISTENER_SERVICE to a narrow set of approved use
      cases. The feature gates itself at runtime by probing for the listener service
      in the merged manifest, so the Play variant never shows the feature at all.
    -->
    <application>
        <service
            android:name="com.inspiredandroid.kai.notifications.KaiNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          POSH's accessibility service powers the device-control tools (read screen,
          tap, type, screenshot). Like the notification listener it is FOSS-only and
          Play-restricted; it only acts when a tool invokes it and observes nothing
          otherwise. The user must switch it on under Settings → Accessibility.
        -->
        <service
            android:name="com.inspiredandroid.kai.accessibility.PoshAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
